#include <stdio.h> 
#include <stdlib.h> 
typedef struct bstree { 
int data; 
struct bstree *lchild, *rchild; 
} node; 
node *createbstree(node *); 
node *getnode(); 
node *search(node *, int); 
void inorder_rec(node *); 
void preorder_rec(node *); 
void postorder_rec(node *); 
node *del(node *); 
int main() { 
node *root = NULL, *temp; 
int ch = 0, srno = 0; 
printf("\nCreate the BST\n"); 
root = createbstree(root); 
do { 
printf("\n--- MENU ---"); 
printf("\n1. Inorder Traversal (Recursive)"); 
printf("\n2. Preorder Traversal (Recursive)"); 
printf("\n3. Postorder Traversal (Recursive)"); 
printf("\n4. Search a Node"); 
printf("\n5. Delete a Node"); 
printf("\n6. Exit"); 
printf("\nEnter your choice: "); 
scanf("%d", &ch); 
switch (ch) { 
case 1: 
printf("\nInorder Traversal:\n"); 
inorder_rec(root); 
break; 
case 2: 
printf("\nPreorder Traversal:\n"); 
preorder_rec(root); 
break; 
case 3: 
printf("\nPostorder Traversal:\n"); 
postorder_rec(root); 
break; 
case 4: 
printf("\nEnter data to search: "); 
scanf("%d", &srno); 
temp = search(root, srno); 
if (temp == NULL) 
printf("\nNode not found in the tree.\n"); 
else 
printf("\nNode with data %d found.\n", temp->data); 
break; 
case 5: 
root = del(root); 
printf("\nInorder traversal after deletion:\n"); 
inorder_rec(root); 
break; 
case 6: 
exit(0); 
default: 
printf("\nInvalid choice! Try again.\n"); 
} 
} while (ch != 6); 
return 0; 
} 
/* CREATE THE BST */ 
node *createbstree(node *root) { 
node *newnode = NULL, *oldnode = NULL; 
char ch; 
do { 
newnode = getnode(); 
if (root == NULL) { 
root = newnode; 
} else { 
oldnode = root; 
while (1) { 
if (newnode->data < oldnode->data) { 
if (oldnode->lchild == NULL) { 
oldnode->lchild = newnode; 
break; 
} else { 
oldnode = oldnode->lchild; 
} 
} else if (newnode->data > oldnode->data) { 
if (oldnode->rchild == NULL) { 
oldnode->rchild = newnode; 
break; 
} else { 
oldnode = oldnode->rchild; 
} 
} else { 
printf("\nDuplicate node can't be created!\n"); 
break; 
} 
} 
} 
printf("\nDo you want to add more nodes? (y/n): "); 
scanf(" %c", &ch); 
} while (ch != 'n' && ch != 'N'); 
return root; 
} 
/* GET A NEW NODE */ 
node *getnode() { 
node *temp = (node *)malloc(sizeof(node)); 
if (temp == NULL) { 
printf("\nMemory allocation error!"); 
exit(0); 
} 
printf("\nEnter the data: "); 
scanf("%d", &temp->data); 
temp->lchild = NULL; 
temp->rchild = NULL; 
return temp; 
} 
/* SEARCH NODE */ 
node *search(node *pt, int srno) { 
while (pt != NULL) { 
if (srno == pt->data) 
return pt; 
else if (srno < pt->data) 
pt = pt->lchild; 
else 
pt = pt->rchild; 
} 
return NULL; 
} 
/* INORDER TRAVERSAL */ 
void inorder_rec(node *pt) { 
if (pt != NULL) { 
inorder_rec(pt->lchild); 
printf("\t%d", pt->data); 
inorder_rec(pt->rchild); 
} 
} 
/* PREORDER TRAVERSAL */ 
void preorder_rec(node *pt) { 
if (pt != NULL) { 
printf("\t%d", pt->data); 
preorder_rec(pt->lchild); 
preorder_rec(pt->rchild); 
} 
} 
/* POSTORDER TRAVERSAL */ 
void postorder_rec(node *pt) { 
if (pt != NULL) { 
postorder_rec(pt->lchild); 
postorder_rec(pt->rchild); 
printf("\t%d", pt->data); 
} 
} 
/* DELETE NODE */ 
node *del(node *root) { 
int no; 
node *temp, *prev, *x, *succ; 
if (root == NULL) { 
printf("\nTree is empty.\n"); 
return root; 
} 
printf("\nEnter data to delete: "); 
scanf("%d", &no); 
temp = root; 
prev = NULL; 
// Search for the node to delete 
while (temp != NULL && temp->data != no) { 
prev = temp; 
if (no < temp->data) 
temp = temp->lchild; 
else 
temp = temp->rchild; 
} 
if (temp == NULL) { 
printf("\nNode not found.\n"); 
return root; 
} 
// Case 1: Leaf node 
if (temp->lchild == NULL && temp->rchild == NULL) { 
if (prev == NULL) 
root = NULL; 
else if (prev->lchild == temp) 
prev->lchild = NULL; 
else 
prev->rchild = NULL; 
printf("\nLeaf node deleted.\n"); 
} 
// Case 2: Only right child 
else if (temp->lchild == NULL) { 
if (prev == NULL) 
root = temp->rchild; 
else if (prev->lchild == temp) 
prev->lchild = temp->rchild; 
else 
prev->rchild = temp->rchild; 
printf("\nNode with right subtree deleted.\n"); 
} 
// Case 3: Only left child 
else if (temp->rchild == NULL) { 
if (prev == NULL) 
root = temp->lchild; 
else if (prev->lchild == temp) 
prev->lchild = temp->lchild; 
else 
prev->rchild = temp->lchild; 
printf("\nNode with left subtree deleted.\n"); 
} 
// Case 4: Two children 
else { 
succ = temp->rchild; 
prev = temp; 
while (succ->lchild != NULL) { 
prev = succ; 
succ = succ->lchild; 
} 
temp->data = succ->data; 
if (prev->lchild == succ) 
prev->lchild = succ->rchild; 
else 
prev->rchild = succ->rchild; 
temp = succ; 
printf("\nNode with two subtrees deleted using inorder successor.\n"); 
} 
free(temp); 
return root; 
} 
