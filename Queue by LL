#include<stdio.h> 
#include<stdlib.h> 
 
struct queue 
{ 
 int number; 
 struct queue *next; 
}*p,*q,*front,*rear; 
 
void init(); 
void add(int); 
int delete(); 
int empty(); 
void display(); 
 
int main() 
{ 
 int ch, num; 
 init(); 
 do 
 { 
  printf("\n Menu \n 1. Add \n 2. Delete \n"); 
  printf("\n Enter your choice : "); 
  scanf("%d", &ch); 
  switch(ch) 
  { 
   case 1 :  
     printf("\n Enter the data : "); 
     scanf("%d", &num); 
     add(num); 
     display(); 
   break; 
      
   case 2 : 
     num = delete(); 
     if(num != -9999) 
     { 
      printf("\n Element deleted = %d", num); 
      display(); 
     } 
   break; 
  } 
 }while(ch<4); 
} 
 
void init() 
{ 
 front = NULL; 
 rear = NULL; 
} 
 
void add(int num) 
{ 
 p = (struct queue *)malloc(sizeof(struct queue)); 
 p->number = num; 
 p->next = NULL; 
 if(rear == NULL) 
 { 
  front = p; 
  rear = p; 
 } 
 else 
 { 
  rear->next = p; 
  rear = p; 
 } 
} 
 
int empty() 
{ 
 if(front == NULL) 
  return 1; 
 else  
  return 0; 
} 
 
void display() 
{ 
 if(front == NULL) 
 { 
  printf("\n Queue is EMPTY !\n"); 
 } 
 else 
 { 
  p = front; 
  while(p != NULL) 
  { 
   printf("\n Content in Queue : "); 
   printf("\n\t%d", p->number); 
   p = p->next; 
  } 
 } 
} 
 
int delete() 
{ 
 int num; 
 if(empty() == 1) 
 { 
  printf("\n Queue is EMPTY !\n"); 
  return -9999; 
 } 
 else 
 { 
  num = front->number; 
  p = front; 
  front = front->next; 
  p->next = NULL; 
  free(p); 
  return num; 
 } 
} 
