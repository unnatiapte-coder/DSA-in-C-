#include<stdio.h> 
#include<stdlib.h> 
#define MAX 5 
struct queue 
{ 
int a[MAX]; 
int front, rear; 
}q1; 
void initialise(); 
void add(int); 
int full(); 
int delete(); 
int empty(); 
void display(); 
int main() 
{ 
int ch,num; 
initialise(); 
do 
{ 
printf("\n MENU\n 1.Add\n 2.Delete\n"); 
scanf("%d",&ch); 
switch(ch) 
{ 
case 1 : printf("Enter data ="); 
scanf("%d",&num); 
add(num); 
display(); 
   break; 
  
   case 2 : 
      num=delete(); 
      if(num!=-9999) 
      printf("element deleted=%d",num); 
      display(); 
   break; 
  } 
 }while(ch<3); 
} 
 
 
void initialise() 
{ 
 q1.front = 0; 
 q1.rear = -1; 
} 
 
void add(int num) 
{ 
 if(full()==1) 
 { 
  printf("\n Queue is Full!\n"); 
 } 
 else 
 { 
  q1.rear++; 
  q1.a[q1.rear] = num; 
 } 
} 
 
int full() 
{ 
 if(q1.rear == MAX-1) 
  return 1; 
 else  
  return 0; 
} 
int empty() 
{ 
 if(q1.front == q1.rear+1) 
  return 1; 
 else  
  return 0; 
} 
 
int delete() 
{ 
 int num; 
 if(empty()==1) 
 { 
  printf("\n Queue is Empty!\n"); 
  return -9999; 
 } 
 else  
 { 
  num = q1.a[q1.front]; 
  q1.front++; 
  return num; 
 } 
} 
 
void display() 
{ 
 int i; 
 if(empty()==1) 
 { 
  printf("\nQueue is Empty!\n"); 
 } 
 else 
 { 
  printf("\n Content of Queue is=\n"); 
  for(i=q1.front;i<=q1.rear;i++) 
  { 
   printf("%d\n",q1.a[i]); 
  } 
 } 
}
